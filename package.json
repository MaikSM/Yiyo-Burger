{
  "name": "restausync-oficcial",
  "version": "1.0.0",
  "description": "Sistema de gestión para restaurante con control de asistencia, inventario y más",
  "scripts": {
    "install:all": "npm run install:frontend && npm run install:backend",
    "install:frontend": "cd frontend && npm install",
    "install:backend": "cd backend && npm install",
    "dev": "npm run dev:frontend",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npm run build",
    "start": "npm run start:backend",
    "start:backend": "cd backend && npm run start",
    "test": "npm run test:frontend",
    "test:frontend": "cd frontend && npm run test",
    "test:e2e": "npx playwright test",
    "lint": "npm run lint:frontend",
    "lint:frontend": "cd frontend && npm run lint",
    "format": "npm run format:frontend",
    "format:frontend": "cd frontend && npm run format",
    "electron:start": "electron .",
    "electron:pack": "electron-builder --dir",
    "electron:dist": "npm run build && electron-builder"
  },
  "keywords": [
    "restaurante",
    "asistencia",
    "inventario",
    "qr",
    "scanner",
    "angular",
    "nodejs",
    "capacitor"
  ],
  "author": "MaikSM",
  "license": "ISC",
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/mapped-types": "^2.1.0",
    "@types/multer": "^2.0.0",
    "axios": "^1.12.2",
    "rxjs": "^7.8.1",
    "bcryptjs": "^2.4.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "escpos": "^3.0.0-alpha.6",
    "escpos-network": "^3.0.0-alpha.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "9.0.2",
    "mongoose": "^8.20.0",
    "morgan": "1.10.0",
    "multer": "^2.0.2",
    "nodemailer": "^8.0.1",
    "reflect-metadata": "^0.2.2",
    "sqlite3": "^5.1.7",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3"
  },
  "main": "main.js",
  "build": {
    "appId": "com.yiyoburger.pos",
    "productName": "Yiyo Burger POS",
    "npmRebuild": false,
    "asarUnpack": [
      "**/node_modules/sqlite3/**/*"
    ],
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "main.js",
      "package.json",
      "backend/dist/**/*",
      "frontend/dist/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "frontend/public/icon.ico",
      "forceCodeSigning": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Yiyo Burger POS"
    }
  }
}
